<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <ApplicationId Condition="'$(PhoneBuild)' != 'true'">com.avashield.yandexhud.headunit</ApplicationId>
    <ApplicationId Condition="'$(PhoneBuild)' == 'true'">com.avashield.yandexhud.phone</ApplicationId>
    <ApplicationVersion>5</ApplicationVersion>
    <ApplicationDisplayVersion Condition="'$(PhoneBuild)' != 'true'">1.4</ApplicationDisplayVersion>
    <ApplicationDisplayVersion Condition="'$(PhoneBuild)' == 'true'">1.4-phone</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <DefineConstants>$(DefineConstants);HEADUNIT</DefineConstants>
    <DefineConstants Condition="'$(PhoneBuild)' == 'true'">$(DefineConstants);PHONE</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1422</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../YandexNotificationBridge/*.cs" Exclude="../YandexNotificationBridge/MainActivity.cs;../YandexNotificationBridge/BridgeServer.cs" Link="Reader/%(Filename)%(Extension)" />
    <Compile Include="../WiiYiiHudNavigator.Plugin.Yandex/BridgeState.cs" Link="Mapping/BridgeState.cs" />
    <Compile Include="../WiiYiiHudNavigator.Plugin.Yandex/HudText.cs" Link="Mapping/HudText.cs" />
    <Compile Include="../WiiYiiHudNavigator.Common/Models/HudNavigationData.cs" Link="Models/HudNavigationData.cs" />
    <Compile Include="../WiiYiiHudNavigator.Common/Models/DirectionInstruction.cs" Link="Models/DirectionInstruction.cs" />
    <Compile Include="../WiiYiiHudNavigator.Common/Models/LaneGuidance.cs" Link="Models/LaneGuidance.cs" />
  </ItemGroup>
</Project>
